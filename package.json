{
  "name": "assay-management",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "setup:token": "node scripts/hash-setup-token.mjs",
    "setup:rotate": "node scripts/rotate-setup-token.mjs",
    "setup:verify": "node scripts/verify-setup-token.mjs",
    "auth:reset-password": "node scripts/reset-user-password.mjs",
    "security:field-key": "node scripts/generate-field-encryption-key.mjs",
    "cloudflare:env": "node scripts/create-cloudflare-production-env.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "asn1js": "^3.0.6",
    "drizzle-orm": "0.45.2",
    "hono": "^4.13.8",
    "lucide-react": "^1.41.0",
    "pkijs": "^3.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.9",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "^19.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "^1.0.0-beta.10",
    "vite": "^8.3.0",
    "wrangler": "^4.131.2"
  },
  "type": "module"
}
